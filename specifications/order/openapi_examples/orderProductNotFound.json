{
  "http-request": {
    "path": "/orders",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Key": "missing-product"
    },
    "body": {
      "productId": 999,
      "quantity": 1
    }
  },
  "http-response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "ProductNotFound",
      "message": "Product 999 was not found"
    }
  }
}
